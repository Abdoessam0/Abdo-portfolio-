DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
ADMIN_SESSION_SECRET=your_random_secret

# Persistent uploads. Production must use s3; local is intended only for development.
UPLOAD_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example-provider.com
S3_REGION=your-region
S3_BUCKET=your-private-configured-public-read-bucket
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_BASE_URL=https://media.example.com
S3_FORCE_PATH_STYLE=false

# Comma-separated HTTPS hostnames approved for manually entered project image URLs.
TRUSTED_IMAGE_HOSTS=media.example.com

# Optional first-user bootstrap.
# If portfolio_admin_users is empty and this password is set, the first login attempt
# can create one admin user. Remove these values after the first admin is created.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-password
